proxmox = {
  endpoint        = "https://pve.example.com:8006"
  insecure        = true
  node_name       = "pve01"
  vm_datastore    = "local-lvm"
  image_datastore = "local"
  ssh_username    = "terraform"
}

# Sensitive Terraform inputs should not live here.
# Use either:
#   export TF_VAR_proxmox_api_token='terraform@pve!talos=...'
# or an encrypted SOPS file based on secrets.sops.tfvars.example.

talos_schematic_id = "<SCHEMATIC_ID>"

cluster_name = "homelab-talos"
# Optional. If null, cluster endpoint uses the generated .200 control plane VIP.
# cluster_endpoint = "https://192.168.10.200:6443"

# Cluster subnet, base domain, service subdomains, Argo CD host, and Piraeus
# settings live in envs/homelab.yaml plus its optional override.

controlplane_node_defaults = {
  cpu_cores = 4
  memory_mb = 8192
  disk_gb   = 40
}

controlplane_nodes = 3

worker_node_defaults = {
  cpu_cores          = 4
  memory_mb          = 8192
  disk_gb            = 40
  additional_disk_gb = 80
}

worker_nodes = 2
