# Copy to envs/homelab.override.yaml and keep only values that differ from
# envs/homelab.yaml. Maps are merged recursively.
cluster:
  base_domain: lab.example.net
  ipv4_cidr: 192.168.10.0/24

gitops:
  repo_url: https://git.example.net/platform/gitops.git
  # Full reviewed Forgejo commit for identity/storage/policy promotion.
  # critical_revision: 0123456789abcdef0123456789abcdef01234567

# Override only subdomains that differ from the base contract.
service_subdomains:
  argocd: cd

storage:
  piraeus:
    device: /dev/sdc
